# Never commit real values. These names must match GitHub Actions secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REQUEST_TIMEOUT_SECONDS=90
# Maximum concurrent synthesis/update jobs; database writes remain sequential.
AI_SUMMARY_CONCURRENCY=10
AI_SUMMARY_REQUEST_TIMEOUT_SECONDS=300
AI_SUMMARY_REASONING_EFFORT=low
AI_SUMMARY_MAX_PAYLOAD_CHARS=300000
AI_SUMMARY_FALLBACK_EXCERPT_WORDS=900
AI_TOPIC_MERGE_EMBEDDING_MIN_SIMILARITY=0.86
AI_TOPIC_MERGE_MAX_RECENT_TITLES=1
AI_CATEGORY_BATCH_SIZE=30
AI_CATEGORY_MIN_RETRY_BATCH_SIZE=10
AI_CATEGORY_MAX_OUTPUT_TOKENS=5000
AI_CATEGORY_REQUEST_TIMEOUT_SECONDS=45
AI_CATEGORY_MAX_RETRIES=2
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
