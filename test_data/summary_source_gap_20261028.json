    },
    {
      "kind": "STATEMENT",
      "lane": "COMMON",
      "fact_id": "fact_1e591dc5070f85fca051f622",
      "text_pl": "Jonas Gahr Støre powiedział, że wojna powoduje ogromne straty ludzkie i materialne, których skutki będą odczuwalne przez pokolenia, oraz że podczas rozmowy podkreślono znaczenie deeskalacji.",
